POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos
POSTGRES_DB=chronos
DATABASE_URL=postgresql+psycopg://chronos:chronos@db:5432/chronos

SIA_CATALOGO_URL=https://sia.unal.edu.co/Catalogo/facespublico/public/servicioPublico.jsf?taskflowId=task-flow-AC_CatalogoAsignaturas

# Auth0 tenant domain (e.g. your-tenant.us.auth0.com) and the identifier of
# the API you register in Auth0 for this backend (Applications > APIs).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://chronos.api

# Client ID of the Auth0 Single Page Application used for login (not
# secret -- it ends up embedded in the frontend bundle regardless).
AUTH0_CLIENT_ID=replace-with-the-spa-application-client-id

FRONTEND_ORIGIN=http://localhost:5173
